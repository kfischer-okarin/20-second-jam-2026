#!/usr/bin/env ruby
# Synthesizes the game's sound effects into mygame/sounds/*.wav (mono, 16 bit, 44.1 kHz).
# Deterministic: running it again produces the same files.

require 'fileutils'

RATE = 44_100
OUTPUT_DIR = File.expand_path('../mygame/sounds', __dir__)

def main
  FileUtils.mkdir_p(OUTPUT_DIR)
  sounds.each do |name, samples|
    path = File.join(OUTPUT_DIR, "#{name}.wav")
    write_wav(path, normalize(samples))
    puts "#{path} (#{(samples.length.to_f / RATE).round(2)}s)"
  end
end

def sounds
  {
    shoot: shoot, hit: hit, explode: explode(0.6, 1), big_explode: explode(1.3, 2), impact: impact,
    rumble: rumble, heartbeat: heartbeat, beep: beep, final: final, start: start, chain: chain,
    ambience: ambience
  }
end

# --- Sounds -----------------------------------------------------------------------------------------------

# Plasma bolt: a square wave diving in pitch, with a click of noise at the start
def shoot
  noise = noise_source(1)
  phase = 0.0
  samples(0.12) do |t|
    phase += exp_sweep(1500.0, 320.0, t / 0.12) / RATE
    tone = square(phase) * 0.55
    click = noise.call * Math.exp(-t * 400)
    (tone + click) * Math.exp(-t * 26)
  end
end

def hit
  noise = noise_source(2)
  samples(0.07) do |t|
    ((noise.call * 0.6) + (Math.sin(2 * Math::PI * 2300 * t) * 0.5)) * Math.exp(-t * 60)
  end
end

# Lowpassed noise whose cutoff closes, over a sine thump that drops in pitch
def explode(length, seed)
  noise = noise_source(seed)
  filter = lowpass
  phase = 0.0
  samples(length) do |t|
    progress = t / length
    phase += exp_sweep(120.0, 35.0, progress) / RATE
    rumble = filter.call(noise.call, (0.5 * ((1 - progress)**2)) + 0.02)
    thump = Math.sin(2 * Math::PI * phase) * Math.exp(-t * 7)
    crackle = (noise.call > 0.985 ? noise.call : 0.0) * (1 - progress)
    saturate(((rumble * 2.2) + thump + crackle) * Math.exp(-t * (3.5 / length)), 1.6)
  end
end

def impact
  noise = noise_source(3)
  filter = lowpass
  phase = 0.0
  samples(1.0) do |t|
    phase += exp_sweep(90.0, 28.0, t) / RATE
    boom = Math.sin(2 * Math::PI * phase) * Math.exp(-t * 4)
    debris = filter.call(noise.call, (0.25 * Math.exp(-t * 3)) + 0.01) * Math.exp(-t * 3.5)
    saturate((boom * 1.4) + (debris * 2.5), 2.2)
  end
end

# Grinding rock: brown-ish noise with a slow wobble and sparse crackles
def rumble
  noise = noise_source(4)
  filter = lowpass
  samples(1.5) do |t|
    wobble = 0.6 + (0.4 * Math.sin(2 * Math::PI * 7 * t))
    body = filter.call(noise.call, 0.04) * 6.0 * wobble
    crackle = noise.call > 0.97 ? noise.call * 0.5 : 0.0
    envelope = [t / 0.05, 1.0].min * Math.exp(-t * 1.8)
    saturate((body + crackle) * envelope, 1.5)
  end
end

def heartbeat
  samples(0.4) do |t|
    thump(t, 0.0, 1.0) + thump(t, 0.17, 0.7)
  end
end

def thump(t, start, gain)
  local = t - start
  return 0.0 if local.negative?

  frequency = 70.0 * Math.exp(-local * 6)
  Math.sin(2 * Math::PI * frequency * local) * Math.exp(-local * 22) * gain
end

def beep
  samples(0.14) do |t|
    tone = Math.sin(2 * Math::PI * 880 * t) + (0.35 * Math.sin(2 * Math::PI * 1760 * t))
    tone * [t / 0.004, 1.0].min * Math.exp(-t * 22)
  end
end

# The planet dies: a sharp crack, a sub drop and a long roar that slowly darkens
def final
  noise = noise_source(5)
  filter = lowpass
  second_filter = lowpass
  phase = 0.0
  samples(4.0) do |t|
    phase += exp_sweep(85.0, 22.0, [t / 2.0, 1.0].min) / RATE
    crack = noise.call * Math.exp(-t * 30) * 1.5
    sub = Math.sin(2 * Math::PI * phase) * Math.exp(-t * 0.9) * 1.3
    roar = filter.call(noise.call, (0.35 * Math.exp(-t * 1.2)) + 0.01) * 4.0 * Math.exp(-t * 0.8)
    bed = second_filter.call(noise.call, 0.015) * 8.0 * Math.exp(-t * 0.6)
    saturate(crack + sub + roar + bed, 2.0)
  end
end

def start
  noise = noise_source(6)
  filter = lowpass
  phase = 0.0
  samples(0.7) do |t|
    progress = t / 0.7
    phase += exp_sweep(160.0, 880.0, progress) / RATE
    tone = square(phase) * 0.35 * Math.sin(Math::PI * progress)
    whoosh = filter.call(noise.call, 0.05 + (0.3 * progress)) * Math.sin(Math::PI * progress) * 1.5
    tone + whoosh
  end
end

def chain
  noise = noise_source(7)
  samples(0.3) do |t|
    bell = Math.sin(2 * Math::PI * 1320 * t) + (0.5 * Math.sin(2 * Math::PI * 1980 * t))
    (bell * Math.exp(-t * 14)) + (noise.call * 0.4 * Math.exp(-t * 80))
  end
end

# A low drone that loops seamlessly: every partial completes a whole number of cycles in four seconds
def ambience
  length = 4.0
  filter = lowpass
  samples(length) do |t|
    swell = 0.7 + (0.3 * Math.sin(2 * Math::PI * t / length))
    raw = saw(55.0 * t) + saw(55.25 * t) + (0.6 * saw(82.5 * t)) + (0.3 * Math.sin(2 * Math::PI * 27.5 * t))
    filter.call(raw, 0.06) * swell
  end
end

# --- Building blocks ----------------------------------------------------------------------------------------

def samples(seconds, &block)
  Array.new((seconds * RATE).round) { |i| block.call(i.to_f / RATE) }
end

def noise_source(seed)
  random = Random.new(seed)
  -> { (random.rand * 2.0) - 1.0 }
end

# One-pole lowpass; amount is the per-sample smoothing factor between 0 and 1
def lowpass
  state = 0.0
  ->(input, amount) { state += (input - state) * amount.clamp(0.0, 1.0) }
end

def exp_sweep(start, finish, progress)
  start * ((finish / start)**progress.clamp(0.0, 1.0))
end

def square(phase)
  (phase % 1.0) < 0.5 ? 1.0 : -1.0
end

def saw(phase)
  ((phase % 1.0) * 2.0) - 1.0
end

def saturate(value, drive)
  Math.tanh(value * drive) / Math.tanh(drive)
end

def normalize(samples, peak: 0.9)
  loudest = samples.map(&:abs).max
  return samples if loudest.zero?

  samples.map { |sample| sample / loudest * peak }
end

def write_wav(path, samples)
  data = samples.map { |sample| (sample.clamp(-1.0, 1.0) * 32_767).round }.pack('s<*')
  header = ['RIFF', 36 + data.bytesize, 'WAVE', 'fmt ', 16, 1, 1, RATE, RATE * 2, 2, 16, 'data', data.bytesize]
           .pack('a4L<a4a4L<S<S<L<L<S<S<a4L<')
  File.binwrite(path, header + data)
end

main
