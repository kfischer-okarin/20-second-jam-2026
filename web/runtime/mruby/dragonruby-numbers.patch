 /*
+ * Like DragonRuby, which has no bigint: an integer literal beyond 32 bits loads as an Integer when it fits into
+ * mrb_int. (The parser turns every such literal into a bigint, which raises a RangeError without mruby-bigint.)
+ */
+static mrb_bool
+read_mrb_int(const char *p, int base, mrb_bool neg, mrb_int *result)
+{
+  uint64_t limit = neg ? (uint64_t)MRB_INT_MAX + 1 : (uint64_t)MRB_INT_MAX;
+  uint64_t value = 0;
+
+  if (*p == '+') p++;
+  for (; *p; p++) {
+    int n;
+    char c = *p;
+
+    if (c == '_') continue;
+    if (c >= '0' && c <= '9') n = c - '0';
+    else if (c >= 'a' && c <= 'f') n = c - 'a' + 10;
+    else if (c >= 'A' && c <= 'F') n = c - 'A' + 10;
+    else return FALSE;
+    if (n >= base) return FALSE;
+    if (value > (limit - n) / base) return FALSE;
+    value = value * base + n;
+  }
+  *result = neg ? (mrb_int)(0 - value) : (mrb_int)value;
+  return TRUE;
+}
+
+static void
+gen_bigint_literal(codegen_scope *s, const char *str, int base, mrb_bool neg)
+{
+  mrb_int i;
+
+  if (read_mrb_int(str, base, neg, &i)) {
+    gen_int(s, cursp(), i);
+  }
+  else {
+    /* Negate base to indicate negative number */
+    genop_2(s, OP_LOADL, cursp(), new_litbint(s, str, neg ? -base : base));
+  }
+}
